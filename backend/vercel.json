{
  "version": 2,
  "functions": {
    "server.js": {
      "runtime": "@vercel/node@latest"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/morning-alerts/trigger",
      "schedule": "0 7 * * *"
    }
  ]
}
