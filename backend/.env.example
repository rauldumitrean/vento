# Configuración del servidor
PORT=3000
NODE_ENV=development

# Seguridad CORS (Dominios separados por comas)
ALLOWED_ORIGINS=http://localhost:5173,https://ventoo.app,https://ventoo.vercel.app

# Base de Datos (PostgreSQL via Supabase/Neon/etc)
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
# DIRECT_URL si usas Prisma con PgBouncer
# DIRECT_URL="postgresql://user:password@host:port/database?schema=public"

# Seguridad / JWT
JWT_SECRET="genera_una_cadena_larga_aleatoria_para_produccion"

# Credenciales de Google Auth (Para verificación en el backend)
GOOGLE_CLIENT_ID="tu_client_id.apps.googleusercontent.com"

# Stripe (Suscripciones y pagos)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Configuración de Servidor SMTP (Para envío de emails)
SMTP_HOST="smtp.tuserver.com"
SMTP_PORT=587
SMTP_USER="hola@ventoo.app"
SMTP_PASS="tu_contraseña_segura"
EMAIL_FROM="Ventoo <hola@ventoo.app>"

# URL del Frontend (Para redirecciones de email, etc.)
FRONTEND_URL="http://localhost:5173"
