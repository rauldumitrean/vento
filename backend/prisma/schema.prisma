generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String?
  authProvider String @default("local") // "local", "google", "apple"
  providerId String?  // ID de Google o Apple
  name       String?
  profilePicture String?
  gender     String?
  role       String   @default("USER")
  isPremium  Boolean  @default(false)
  usaGorras  Boolean?
  estiloPersonal String?
  estiloDetalles String?
  age        Int?
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  premiumPlan          String?  // "monthly" o "lifetime"
  isBanned             Boolean  @default(false)
  bannedUntil          DateTime?
  banReason            String?
  friendCode         String?  @unique
  morningAlerts      Boolean  @default(false)
  alertHour          Int      @default(7)
  alertCityName      String?
  createdAt  DateTime @default(now())
  lastActive DateTime @default(now())
  sessionVersion Int  @default(0)
  consultas  Consulta[]
  prendas    PrendaArmario[]
  tickets    Ticket[]
  friendshipsSent     Friendship[] @relation("UserFriendshipsSent")
  friendshipsReceived Friendship[] @relation("UserFriendshipsReceived")
  messagesSent        DirectMessage[] @relation("UserMessagesSent")
  messagesReceived    DirectMessage[] @relation("UserMessagesReceived")
  reportsSent         Report[] @relation("UserReportsSent")
  reportsReceived     Report[] @relation("UserReportsReceived")
  favoriteCities      FavoriteCity[]
  outfitLikes         OutfitLike[]
  viajes              ViajeGuardado[]
  notifications       Notification[]

  @@index([lastActive])
  @@index([isPremium])
}

model Consulta {
  id                 Int      @id @default(autoincrement())
  userId             Int
  ubicacion          String
  clima_json         String
  recomendacion_json String
  createdAt          DateTime @default(now())
  isFavorite         Boolean  @default(false)
  isShared           Boolean  @default(false)
  isPublic           Boolean  @default(false)
  user               User     @relation(fields: [userId], references: [id])
  mensajes           MensajeChat[]
  directMessages     DirectMessage[]
  outfitLikes        OutfitLike[]

  @@index([userId, createdAt])
  @@index([userId, isFavorite])
  @@index([isPublic, createdAt])
}

model MensajeChat {
  id         Int      @id @default(autoincrement())
  consultaId Int
  rol        String   // "user" or "model"
  contenido  String
  createdAt  DateTime @default(now())
  consulta   Consulta @relation(fields: [consultaId], references: [id])

  @@index([consultaId, createdAt])
}

model PrendaArmario {
  id          Int      @id @default(autoincrement())
  userId      Int
  categoria   String   // ej. "top", "bottom", "calzado", "abrigo"
  descripcion String   // ej. "Camiseta básica manga corta"
  color       String?  // ej. "Blanca"
  imageUrl    String?  // URL de la foto de la prenda subida por el usuario
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, categoria])
  @@index([userId, createdAt])
}

model Ticket {
  id        Int      @id @default(autoincrement())
  userId    Int
  asunto    String
  mensaje   String
  estado    String   @default("ABIERTO") // ABIERTO | CERRADO
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, estado])
}

model Friendship {
  id        Int      @id @default(autoincrement())
  user1Id   Int
  user2Id   Int
  status    String   @default("pending") // "pending", "accepted"
  createdAt DateTime @default(now())

  user1     User     @relation("UserFriendshipsSent", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User     @relation("UserFriendshipsReceived", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id, status])
  @@index([user2Id, status])
}

model DirectMessage {
  id          Int      @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  content     String   @db.Text
  outfitId    Int?     // Referencia opcional a Consulta si es un outfit compartido
  createdAt   DateTime @default(now())

  sender      User     @relation("UserMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("UserMessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  outfit      Consulta? @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, createdAt])
}

model Report {
  id          Int      @id @default(autoincrement())
  reporterId  Int
  reportedId  Int
  reason      String
  description String?
  status      String   @default("pending") // pending, reviewed, resolved
  createdAt   DateTime @default(now())

  reporter    User     @relation("UserReportsSent", fields: [reporterId], references: [id], onDelete: Cascade)
  reported    User     @relation("UserReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@unique([reporterId, reportedId])
  @@index([reportedId, status])
}

model ImageCache {
  id        Int      @id @default(autoincrement())
  promptKey String   @unique
  imageUrl  String   @db.Text
  hitCount  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([promptKey])
  @@index([createdAt])
}

model FavoriteCity {
  id        Int      @id @default(autoincrement())
  userId    Int
  cityName  String
  lat       Float?
  lon       Float?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cityName])
  @@index([userId])
}

model OutfitLike {
  id         Int      @id @default(autoincrement())
  userId     Int
  consultaId Int
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consulta   Consulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@unique([userId, consultaId])
  @@index([consultaId])
  @@index([userId])
}

model ViajeGuardado {
  id               Int      @id @default(autoincrement())
  userId           Int
  destination      String
  startDate        String
  endDate          String
  packingListJson  String   @db.Text
  checkedItemsJson String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // e.g. "morning_alert", "friend_request"
  content   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}
